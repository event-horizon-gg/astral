{
  "name": "astral-companion",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Your addons and your interface, at home on every computer.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run lint && vite build",
    "start": "electron .",
    "test": "npm run lint && node --test tests/*.test.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:windows": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "addons:suite": "node scripts/install-suite.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@wowserhq/format": "^0.28.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "fengari": "^0.1.5",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "vite": "8.3.5"
  },
  "author": "Joao Seixas"
}
